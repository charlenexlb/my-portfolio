---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Cursor from "../components/Cursor.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
}

const { title = site.title } = Astro.props;

// Social previews (LinkedIn, WhatsApp, Slack…) need full URLs, which come from `site` in astro.config.mjs
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL("/og.png", Astro.site ?? Astro.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>

    <!-- Link preview when the site is shared. Image: public/og.png (1200×630) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, software engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <!-- Body text: Inter, 16px, line height ~1.6 -->
  <body class="bg-white font-sans text-base leading-relaxed text-stone-800 antialiased">
    <Cursor />
    <Header />
    <main>
      <slot />
    </main>
    <footer class="border-t border-stone-200 px-12 py-10">
      <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
        <p class="text-sm text-stone-600">© {new Date().getFullYear()} {site.name}</p>
        <SocialLinks links={["linkedin", "github", "instagram", "email"]} size="sm" />
      </div>
    </footer>
    <script>
      import "../scripts/smooth-scroll";
      import "../scripts/reveal";
      import "../scripts/header";
      import "../scripts/scribble";
      import "../scripts/cursor";
      import "../scripts/scenes";
    </script>
  </body>
</html>
